# =============================================================================
# REQUIRED: Database
# =============================================================================

# MongoDB connection string. Supports:
# - Local Docker: mongodb://127.0.0.1:27017/payload-portfolio
# - MongoDB Atlas: mongodb+srv://user:password@cluster.mongodb.net/dbname
# Use separate database for local dev and production.
DATABASE_URL=mongodb://127.0.0.1:27017/payload-portfolio

# =============================================================================
# REQUIRED: Secrets (generate: openssl rand -base64 32)
# =============================================================================

# Encrypts JWT tokens. Use unique value for each environment (dev/prod).
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Validates draft preview URLs. Use unique value for each environment.
PREVIEW_SECRET=replace-with-a-long-random-secret

# Authenticates scheduled sync requests (Substack, Medium, Paragraph).
# Required only if using scheduled content import. Use unique value.
# Generate: openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-secret

# =============================================================================
# REQUIRED: Site URLs (no trailing slash)
# =============================================================================

# Used by Payload for CORS, preview links, redirects, admin access.
# Local dev: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Used for OpenGraph, canonical links, sitemap, social sharing.
# Typically same as NEXT_PUBLIC_SERVER_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# Portfolio Identity & SEO
# =============================================================================

# Your name. Used in page titles, Open Graph, and metadata.
NEXT_PUBLIC_SITE_OWNER_NAME=Your Name

# Your role/title. Used in metadata and homepage hero.
NEXT_PUBLIC_SITE_OWNER_ROLE=Designer and Developer

# Full site title for browser tab and search results.
NEXT_PUBLIC_SITE_TITLE=Your Name — Portfolio

# Site description for Open Graph and search engine previews.
NEXT_PUBLIC_SITE_DESCRIPTION=Portfolio, selected work, writing, and ways to collaborate.

# Social media handles (optional, used in meta tags and footer).
NEXT_PUBLIC_TWITTER_HANDLE=
NEXT_PUBLIC_LINKEDIN_URL=
LINKEDIN_PROFILE_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_SOCIAL_URL=

# OpenGraph default image (absolute path or full URL).
# Used when pages don't have custom OG images. Recommendation: 1200×630px
NEXT_PUBLIC_DEFAULT_OG_IMAGE_PATH=/og-default.svg

# Optional: Serve `/poetry` from dedicated subdomain (e.g., poetry.example.com).
# Requires DNS record and Netlify domain configuration.
NEXT_PUBLIC_POETRY_HOSTNAME=

# =============================================================================
# Content Sync: Substack, Medium, Paragraph
# =============================================================================

# --- Substack ---
# Publication base URL (used by subscribe form in footer).
NEXT_PUBLIC_SUBSTACK_URL=https://yourpublication.substack.com
SUBSTACK_SUBSCRIBE_URL=https://yourpublication.substack.com

# RSS feed URL for importing articles into Posts collection.
# Typically: https://yourpublication.substack.com/feed
SUBSTACK_RSS_URL=https://yourpublication.substack.com/feed

# Enable automatic sync (requires CRON_SECRET). Defaults true if not set.
SUBSTACK_SYNC_ENABLED=false

# Import mode: 'review' (drafts for approval) or 'auto_publish' (go live immediately).
SUBSTACK_SYNC_MODE=review

# Download images from Substack and store in Media collection.
SUBSTACK_SYNC_DOWNLOAD_IMAGES=true

# Max articles to import per sync run. Recommend: 20-50
SUBSTACK_SYNC_MAX_ITEMS=20

# Max images to import per article. Recommend: 10-25
SUBSTACK_SYNC_MAX_IMAGES_PER_POST=25

# Email to assign to imported posts (if author not found in system).
SUBSTACK_DEFAULT_AUTHOR_EMAIL=

# Email notification when sync completes (optional).
SUBSTACK_SYNC_NOTIFY_EMAIL=

# --- Medium ---
# Enable automatic sync from Medium RSS feed.
MEDIUM_SYNC_ENABLED=false

# RSS feed URL: https://medium.com/feed/@yourhandle
MEDIUM_RSS_URL=https://medium.com/feed/@yourhandle

# Import mode: 'review' or 'auto_publish'
MEDIUM_SYNC_MODE=review

# Download images from Medium
MEDIUM_SYNC_DOWNLOAD_IMAGES=true

# Email to assign to imported posts
MEDIUM_DEFAULT_AUTHOR_EMAIL=

# --- Paragraph ---
# Enable automatic sync from Paragraph publication.
PARAGRAPH_SYNC_ENABLED=false

# Publication slug or URL (e.g., @yourpublication or https://paragraph.com/@yourpublication)
PARAGRAPH_PUBLICATION=@yourpublication

# Import mode: 'review' or 'auto_publish'
PARAGRAPH_SYNC_MODE=review

# Download images from Paragraph
PARAGRAPH_SYNC_DOWNLOAD_IMAGES=true

# Email to assign to imported posts
PARAGRAPH_DEFAULT_AUTHOR_EMAIL=

# =============================================================================
# Analytics (Optional)
# =============================================================================

# Google Analytics measurement ID (e.g., G-XXXXXXXXXX).
# Get from Google Analytics dashboard. Leave blank to disable.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Microsoft Clarity session recording (optional).
# Get from https://clarity.microsoft.com. Leave blank to disable.
NEXT_PUBLIC_ENABLE_CLARITY=false
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# =============================================================================
# Email Notifications (Optional)
# =============================================================================

# Enable SMTP verification on startup (for form notifications).
# Requires PROTON_SMTP_USER and PROTON_SMTP_TOKEN.
EMAIL_VERIFY_TRANSPORT=false

# Proton Mail SMTP username (email address).
PROTON_SMTP_USER=

# Proton Mail app-specific password (NOT your account password).
# Generate at https://mail.proton.me/u/0/settings/passwords
PROTON_SMTP_TOKEN=

# =============================================================================
# Amazon Associates / Affiliate (Optional)
# =============================================================================

# Your Amazon Associates tag (e.g., "yourname-20").
# Used to add affiliate links to Amazon product blocks.
AMAZON_ASSOCIATE_TAG=

# Public version of tag (same value, used in frontend).
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=

# =============================================================================
# Media Storage: Local (Development) vs R2 (Production)
# =============================================================================

# Enable Cloudflare R2 for persistent media storage.
# Local dev: false (files stored in public/media/)
# Production: true (files stored in R2 bucket)
USE_R2_STORAGE=false

# Force all media reads through Payload proxy (/api/media/file/*).
# Usually false. Set true only if direct R2 URLs don't work.
NEXT_PUBLIC_USE_PAYLOAD_MEDIA_PROXY=false

# --- R2 Configuration (required if USE_R2_STORAGE=true) ---

# Your Cloudflare account ID (visible in R2 bucket settings).
R2_ACCOUNT_ID=

# R2 bucket name (e.g., "portfolio-media").
R2_BUCKET=

# R2 API token access key. Generate in Cloudflare dashboard.
R2_ACCESS_KEY_ID=

# R2 API token secret. Store securely, never commit.
R2_SECRET_ACCESS_KEY=

# Public domain for R2 files (e.g., media.yourdomain.com).
# Set up as custom domain in R2 bucket settings.
# If not set, falls back to app proxy at /api/media/file/*
R2_PUBLIC_HOSTNAME=

# Optional: R2 endpoint override (for regional buckets).
# Default: https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
# EU: https://{R2_ACCOUNT_ID}.eu.r2.cloudflarestorage.com
R2_ENDPOINT=

# Use S3 path-style URLs (usually true for R2).
R2_FORCE_PATH_STYLE=true

# Prefix for media object keys in R2 bucket (default: media)
R2_MEDIA_PREFIX=media

# Prefix for document object keys in R2 bucket (default: documents)
R2_DOCUMENTS_PREFIX=documents

# HTTP cache headers for R2 files (immutable, 1-year TTL).
R2_CACHE_CONTROL=public, max-age=31536000, immutable

# =============================================================================
# Database Seeding (Local Development Only)
# =============================================================================

# Set to true to enable /next/seed route in production.
# WARNING: Destructive. Keep false except during one-time initial seed.
ALLOW_SEED_IN_PROD=false

# Set to true to reseed database (deletes existing starter content).
# Use only when you intentionally want to reset and repopulate.
RESTORE_FORCE=false

# Email for admin user created during seeding.
# Example: you@example.com
RESTORE_ADMIN_EMAIL=

# Password for admin user created during seeding.
# Use strong, unique password. Not used after seeding.
RESTORE_ADMIN_PASSWORD=

# =============================================================================
# Payload / Next.js Configuration
# =============================================================================

# Enable live preview in Payload admin (show draft edits in real time).
PAYLOAD_DEV_LIVE_PREVIEW=true

# Enable full local Payload plugins (slower dev rebuild, but simpler setup).
PAYLOAD_ENABLE_FULL_LOCAL_PLUGINS=false

# Stable encryption key for Next.js Server Actions (prevents "not found" errors on rebuild).
# Generate: openssl rand -base64 32
# Important for production to keep this constant across deploys.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
