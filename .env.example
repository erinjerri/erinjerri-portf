# =============================================================================
# Required for local development
# =============================================================================

# MongoDB connection string. Local Docker default:
DATABASE_URL=mongodb://127.0.0.1:27017/payload-portfolio

# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=replace-with-a-long-random-secret

# No trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
PREVIEW_SECRET=replace-with-a-long-random-secret

# =============================================================================
# Portfolio identity and SEO
# =============================================================================

NEXT_PUBLIC_SITE_OWNER_NAME=Your Name
NEXT_PUBLIC_SITE_OWNER_ROLE=Designer and Developer
NEXT_PUBLIC_SITE_TITLE=Your Name — Portfolio
NEXT_PUBLIC_SITE_DESCRIPTION=Portfolio, selected work, writing, and ways to collaborate.
NEXT_PUBLIC_TWITTER_HANDLE=
NEXT_PUBLIC_LINKEDIN_URL=
LINKEDIN_PROFILE_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_SOCIAL_URL=
NEXT_PUBLIC_DEFAULT_OG_IMAGE_PATH=/og-default.svg

# Optional: serve `/poetry` from a dedicated hostname such as poetry.example.com.
NEXT_PUBLIC_POETRY_HOSTNAME=

# =============================================================================
# Substack
# =============================================================================

# Publication base URL used by subscribe forms.
NEXT_PUBLIC_SUBSTACK_URL=https://yourpublication.substack.com
SUBSTACK_SUBSCRIBE_URL=https://yourpublication.substack.com

# RSS feed used to import posts into Payload.
SUBSTACK_RSS_URL=https://yourpublication.substack.com/feed
SUBSTACK_SYNC_ENABLED=false
SUBSTACK_SYNC_MODE=review
SUBSTACK_SYNC_DOWNLOAD_IMAGES=true
SUBSTACK_SYNC_MAX_ITEMS=20
SUBSTACK_SYNC_MAX_IMAGES_PER_POST=25
SUBSTACK_DEFAULT_AUTHOR_EMAIL=
SUBSTACK_SYNC_NOTIFY_EMAIL=

# Required only for scheduled sync endpoints.
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-secret

# =============================================================================
# Optional Medium and Paragraph imports
# =============================================================================

MEDIUM_SYNC_ENABLED=false
MEDIUM_RSS_URL=https://medium.com/feed/@yourhandle
MEDIUM_SYNC_MODE=review
MEDIUM_SYNC_DOWNLOAD_IMAGES=true
MEDIUM_DEFAULT_AUTHOR_EMAIL=

PARAGRAPH_SYNC_ENABLED=false
PARAGRAPH_PUBLICATION=@yourpublication
PARAGRAPH_SYNC_MODE=review
PARAGRAPH_SYNC_DOWNLOAD_IMAGES=true
PARAGRAPH_DEFAULT_AUTHOR_EMAIL=

# =============================================================================
# Optional analytics
# =============================================================================

NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ENABLE_CLARITY=false
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# =============================================================================
# Optional email notifications
# =============================================================================

EMAIL_VERIFY_TRANSPORT=false
PROTON_SMTP_USER=
PROTON_SMTP_TOKEN=

# =============================================================================
# Optional Amazon Associates support
# =============================================================================

AMAZON_ASSOCIATE_TAG=
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=

# =============================================================================
# Optional Cloudflare R2 media storage
# =============================================================================

USE_R2_STORAGE=false
NEXT_PUBLIC_USE_PAYLOAD_MEDIA_PROXY=false
R2_PUBLIC_READS=false
R2_PUBLIC_HOSTNAME=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_FORCE_PATH_STYLE=true
R2_MEDIA_PREFIX=media
R2_DOCUMENTS_PREFIX=documents
R2_CACHE_CONTROL=public, max-age=31536000, immutable

# =============================================================================
# Seeding and local Payload behavior
# =============================================================================

# Keep false in production except during the one-time initial seed.
ALLOW_SEED_IN_PROD=false
RESTORE_FORCE=false
RESTORE_ADMIN_EMAIL=
RESTORE_ADMIN_PASSWORD=
PAYLOAD_DEV_LIVE_PREVIEW=true
PAYLOAD_ENABLE_FULL_LOCAL_PLUGINS=false

# Optional stable Server Action encryption key for production builds.
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
